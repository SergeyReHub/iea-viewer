# IEA Viewer v2 — конфигурация окружения

API_PORT=8010
CORS_ORIGINS=*

# Активный источник IEA (PostgreSQL с накатанной схемой ETL)
IEA_DB_URL=postgresql://postgres:postgres@192.168.245.32:5432/iea_data

# Альтернатива: libpq-переменные (если IEA_DB_URL не задан)
PGHOST=192.168.245.32
PGPORT=5432
PGDATABASE=iea_data
PGUSER=postgres
PGPASSWORD=postgres

# Путь к каталогу источников (в Docker — /config/sources.yaml)
SOURCES_CONFIG=config/sources.yaml

# Пул подключений per active source
DB_POOL_MIN=1
DB_POOL_MAX=5

# Frontend (локальный npm run dev в frontend/)
# По умолчанию Vite проксирует /api → http://127.0.0.1:8010
# Если backend в Docker на другом порту (напр. 8011:8010), раскомментируйте:
# VITE_DEV_API_PROXY=http://127.0.0.1:8011
# или прямой URL без proxy:
# VITE_API_URL=http://localhost:8011/api
VITE_API_URL=
VITE_DEV_API_PROXY=

# Host-порт backend в Docker (если 8010 занят — поставьте 8011)
API_HOST_PORT=8010

# Идентификация и аудит при доступе через Docker Desktop / внешний IP хоста
# AUDIT_VIEWER_IPS — IP с правом просмотра журнала аудита (через запятую)
# IDENTITY_IP_MAP_EXTRA — JSON: IP Docker-шлюза → ФИО, если backend видит 172.x.x.x вместо LAN-IP
# AUDIT_VIEWER_IPS=192.168.235.89,172.30.0.1,172.17.0.1
# IDENTITY_IP_MAP_EXTRA={"172.30.0.1":"Иванов Иван Иванович","172.17.0.1":"Иванов Иван Иванович"}

# Будущие источники (Phase 4) — раскомментировать при появлении БД
# EUROSTAT_DB_URL=
# JODI_DB_URL=
# EIA_DB_URL=
# OPEC_DB_URL=
# ENERGY_INSTITUTE_DB_URL=
# TRADEMAP_DB_URL=
# UN_COMTRADE_DB_URL=
