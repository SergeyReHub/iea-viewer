BACKEND_IMAGE=registry.example.com/group/iea-viewer-v2/backend:latest
FRONTEND_IMAGE=registry.example.com/group/iea-viewer-v2/frontend:latest

# IEA data 2 ETL database (v2). v1 used mea_data.
IEA_DB_URL=postgresql://postgres:postgres@192.168.245.32:5432/iea_data
PGHOST=192.168.245.32
PGPORT=5432
PGDATABASE=iea_data
PGUSER=postgres
PGPASSWORD=postgres

CORS_ORIGINS=*

# Optional: IP allowlist for audit journal (comma-separated)
AUDIT_VIEWER_IPS=

# Optional: JSON map of IP -> display name for audit
# IDENTITY_IP_MAP_EXTRA={"172.30.0.1":"Kudryashov"}

# Set to true once on cutover to overwrite presets in the Docker volume
FORCE_SEED_PRESETS=true

# Optional: path to legacy v1 checkout on the runner (for deploy/stop-v1.sh)
# V1_COMPOSE_DIR=/home/gitlab-runner/builds/iea-viewer
